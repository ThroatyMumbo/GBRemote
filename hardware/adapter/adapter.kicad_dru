(version 1)

(rule plug_edge_clearance
    (constraint edge_clearance (min 0mm))
    (condition "A.memberOfFootprint('J1')"))

(rule plug_b_row_netless
    (constraint clearance (min -1mm))
    (condition "A.memberOfFootprint('J1') && B.memberOfFootprint('J1') && (A.NetName == '' || B.NetName == '')"))
