	(footprint "WireTerminal_1x12_Staggered"
		(layer "F.Cu")
		(uuid "5ed7d982-b220-5fa5-9ff0-c73f2caf6b86")
		(at 100 111.6)
		(descr "Solder terminals for 12 discrete wires, 26-30 AWG. Two staggered rows of 6, 2.00 mm pitch within a row, 1.00 mm stagger; pin 1 at -X, even pins in the front row, running the same way as the plug's row A. Each terminal is one oval thru-hole pad 1.4 x 3.6 whose copper is offset 1.0 mm forward of its 0.9 mm hole, so the hole sits at the rear lip: the wire enters from the underside, bends 90 deg at the barrel and lies 2.3 mm along the pad, and pull is taken by the bend and not the joint. Pad origins are the holes. The 0.6 mm gaps between front-row pads each pass exactly one rear-row trace.")
		(tags "wire solder terminal pigtail staggered")
		(property "Reference" "J2"
			(at 0 -4 0)
			(layer "F.SilkS")
